# Supabase (varsayılan veri + auth kaynağı)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt

POSTGRES_DATABASE=postgres
POSTGRES_HOST=db.your-project.supabase.co
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-db-password
POSTGRES_URL=postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
POSTGRES_PRISMA_URL=postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
POSTGRES_URL_NON_POOLING=postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require

DATABASE_URL=postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
DIRECT_URL=postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require

# Eski Algory gateway/auth’e dönmek için:
# NEXT_PUBLIC_USE_RENT_GATEWAY=true
# NEXT_PUBLIC_USE_ALGORY_AUTH=true

# Seed giriş (npm run db:seed sonrası):
#   admin@algoryrent.test / AlgoryRent2026!  (RENT_ADMIN)
#   operator@algoryrent.test / AlgoryRent2026!  (RENT_MANAGER)
#   tkuru@gmail.com / tkuru123  (RENT_ADMIN)

# Opsiyonel
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_RENT_GATEWAY_URL=
NEXT_PUBLIC_GREEN_INSURANCE_FEE=50
